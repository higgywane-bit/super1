{
  "name": "super1",
  "private": true,
  "type": "module",
  "description": "SUPER1: the Superfit operating system. Desk, owner and admin on super1.world; members, coaches and sign-up on super1.app.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:test": "bash scripts/db-test.sh",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "e2e": "playwright test",
    "db:start": "SUPABASE_INTERNAL_IMAGE_REGISTRY=${SUPABASE_INTERNAL_IMAGE_REGISTRY:-docker.io} supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:reset": "supabase db reset --local",
    "db:types": "supabase gen types typescript --local --schema public | (echo '// Generated by `npm run db:types` (supabase gen types typescript --local). Do not edit by hand.'; cat) > src/server/db.types.ts",
    "invite": "node scripts/invite-login.mjs",
    "e2e:fresh": "supabase db reset --local && bash scripts/demo-setup.sh && playwright test",
    "migration:rehearse": "bash scripts/rehearse-migration.sh",
    "legacy:load": "node scripts/legacy-load.mjs",
    "migration:verify": "node scripts/verify-migration.ts",
    "images:copy": "node scripts/copy-images.mjs",
    "cutover:check": "bash scripts/cutover-check.sh"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postgres": "^3.4.7",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "4.1.11",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-start": "^1.168.61",
    "lucide-react": "^1.55.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  }
}
