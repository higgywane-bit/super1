// SUPER1: one Worker for super1.world and super1.app (docs/10-DEPLOY.md).
// Secrets (never in this file): SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, TURNSTILE_SECRET_KEY, CRON_SECRET.
//   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
// Local development reads them from .dev.vars (copy .env.example).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super1",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "super1.world", "custom_domain": true },
    { "pattern": "www.super1.world", "custom_domain": true },
    { "pattern": "super1.app", "custom_domain": true },
    { "pattern": "www.super1.app", "custom_domain": true }
  ],
  "vars": {
    "APP_ORIGIN_WORLD": "https://super1.world",
    "APP_ORIGIN_APP": "https://super1.app"
  },
  "triggers": {
    // Every minute: outbox. 19:00 UTC = 02:00 Bangkok: reminders + abandoned sign-ups. 20:00 UTC = 03:00 Bangkok: backup check.
    "crons": ["* * * * *", "0 19 * * *", "0 20 * * *"]
  },
  "env": {
    "staging": {
      "name": "super1-staging",
      "routes": [],
      "workers_dev": true,
      "vars": { "APP_ORIGIN_WORLD": "", "APP_ORIGIN_APP": "" }
    }
  }
}
