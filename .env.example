# Copy to .dev.vars for local development (the Worker reads it) and set the same names as Worker
# variables/secrets in Cloudflare. Never commit real values. See docs/10-DEPLOY.md.
#
# Local: `npm run db:start` prints the local Supabase URL and keys.

# Public client (also sent to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Worker secret only: Qashier import, outbox worker, invites, signature uploads. Never sent to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Worker secret: outbox emails
RESEND_API_KEY=
# Sender for outbox emails (to confirm, docs/11-OPEN-QUESTIONS.md #17)
EMAIL_FROM=SUPER1 <hello@super1.app>
# Cloudflare Turnstile for /join: site key is public, secret is a Worker secret
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# The two domains (development: http://world.localhost:3000 and http://app.localhost:3000)
APP_ORIGIN_WORLD=https://super1.world
APP_ORIGIN_APP=https://super1.app
# Worker secret: protects the outbox and nightly endpoints when called by hand
CRON_SECRET=
